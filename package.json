{
	"version": "2.1.0",
	"name": "cs2parser",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/osztenkurden/cs2parser.git"
	},
	"bugs": {
		"url": "https://github.com/osztenkurden/cs2parser/issues"
	},
	"homepage": "https://github.com/osztenkurden/cs2parser#readme",
	"dependencies": {
		"@bufbuild/protobuf": "^2.10.0",
		"events": "^3.3.0"
	},
	"license": "GPL-3.0",
	"engines": {
		"node": ">=22.0.0"
	},
	"files": [
		"./dist",
		"ACKNOWLEDGEMENTS",
		"MIGRATION.md"
	],
	"types": "./dist/index.d.mts",
	"exports": {
		".": "./dist/index.mjs",
		"./package.json": "./package.json",
		"./browser": {
			"types": "./dist/browser.d.mts",
			"import": "./dist/browser.mjs",
			"default": "./dist/browser.mjs"
		}
	},
	"scripts": {
		"typecheck": "tsc && tsc -p tsconfig.browser.json",
		"format": "prettier --write src/",
		"format:check": "prettier --check src/",
		"build": "npm run generate:messages:check && npm run generate:delta-schema:check && bun scripts/build-snappy-wasm.ts --check && bun scripts/generate-broadcast-descriptors.ts --check && npm run typecheck && tsdown",
		"test": "bun test --timeout 300000",
		"test:watch": "bun test --watch --timeout 300000",
		"test:coverage": "bun test --coverage --timeout 300000",
		"test:node": "node tests/node/package.smoke.mjs",
		"prepublishOnly": "npm run format:check && npm run build",
		"prepare": "husky",
		"generate:entities": "bun scripts/generate-entity-types.ts",
		"generate:events": "bun scripts/generate-event-types.ts",
		"generate:protos": "bun scripts/generate-protos.ts",
		"generate:messages": "bun scripts/generate-message-registry.ts",
		"generate:delta-schema": "bun scripts/generate-usercmd-delta-schema.ts",
		"generate:delta-schema:check": "bun scripts/generate-usercmd-delta-schema.ts --check",
		"generate:messages:check": "bun scripts/generate-message-registry.ts --check",
		"generate": "bun scripts/generate-protos.ts && bun scripts/generate-message-registry.ts && bun scripts/generate-usercmd-delta-schema.ts && bun scripts/generate-entity-types.ts --snapshot",
		"benchmark": "bun scripts/benchmark-compare.mjs",
		"build:snappy": "bun scripts/build-snappy-wasm.ts",
		"build:all": "bun scripts/build-all.ts",
		"generate:broadcast-descriptors": "bun scripts/generate-broadcast-descriptors.ts",
		"test:browser": "npm run build && tsc -p tests/browser/tsconfig.json && playwright test"
	},
	"devDependencies": {
		"@commitlint/cli": "^20.5.0",
		"@commitlint/config-conventional": "^20.5.0",
		"@playwright/test": "^1.63.0",
		"@types/bun": "^1.3.11",
		"@types/node": "^22.17.2",
		"husky": "^9.1.7",
		"prettier": "^3.0.3",
		"snappy": "^7.3.3",
		"ts-proto": "2.11.6",
		"tsdown": "^0.22.7",
		"typescript": "^7.0.2"
	}
}
